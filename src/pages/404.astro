---
import Base from "../layouts/Base.astro";
---

<Base title="404 — Ayach Youssef" description="Page not found.">
  <section class="study-head container">
    <p class="eyebrow">Error 404</p>
    <h1 class="display">This page never shipped.</h1>
    <p class="lede">
      The address may have changed, or it never existed. Everything real is one
      click away.
    </p>
    <div class="hero-actions" style="margin-top: var(--space-8)">
      <a href="/" class="btn btn-primary">Back to the front page</a>
      <a href="/log/" class="btn">Read the Ship Log</a>
    </div>
  </section>
</Base>
