---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import ProjectRow from "../../components/ProjectRow.astro";
import {
  GROUPS,
  byGroup,
  caseStudies,
  counts,
  type Project,
} from "../../data/projects";

const n = counts();
const studies = caseStudies();

/** Inside a group: case studies are in the strip above, so leave them out;
 *  the strongest four become cards, the rest compact rows. */
const rank = (p: Project) =>
  (p.status === "live" || p.status === "released" ? 0 : 2) +
  (p.built === "me" ? 0 : 1);
const split = (list: Project[]) => {
  const rest = list
    .filter((p) => !p.caseStudy)
    .sort((a, b) => rank(a) - rank(b) || b.date.localeCompare(a.date));
  return { cards: rest.slice(0, 4), rows: rest.slice(4) };
};
---

<Base
  title="Projects — Ayach Youssef"
  description={`${n.total} projects by Ayach Youssef, a software engineer focused on backend & DevOps: five case studies, then infrastructure, backend services, products and tooling, each with its status and source.`}
>
  <section class="study-head container">
    <p class="eyebrow">Projects</p>
    <h1 class="display">Things I&rsquo;ve shipped</h1>
    <p class="lede">
      {n.total} projects since mid-2026: {n.live} with a public URL, {
        n.released
      }
      released as installable tools, the rest code-complete on GitHub. Five get a
      full case study. Every entry says what it is, what it runs on, and whether it
      is actually live.
    </p>
  </section>

  <section class="section" id="case-studies">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Case studies</p>
        <h2 class="display">The five worth reading in full</h2>
        <p class="lede">
          What it is, how it is built, what went wrong, and what is still open.
        </p>
      </div>
      <div class="bento">
        {studies.map((p, i) => <ProjectCard project={p} index={i} />)}
      </div>
    </div>
  </section>

  {
    GROUPS.map((g) => {
      const { cards, rows } = split(byGroup(g.id));
      return (
        <section class="section" id={g.id}>
          <div class="container">
            <div class="section-head reveal">
              <p class="eyebrow">{g.eyebrow}</p>
              <h2 class="display">{g.title}</h2>
              <p class="lede">{g.lede}</p>
            </div>
            {cards.length > 0 && (
              <div class="bento">
                {cards.map((p, i) => (
                  <ProjectCard project={p} index={i} />
                ))}
              </div>
            )}
            {rows.length > 0 && (
              <div class="rows reveal" style="margin-top: var(--space-8)">
                {rows.map((p) => (
                  <ProjectRow project={p} />
                ))}
              </div>
            )}
          </div>
        </section>
      );
    })
  }

  <section class="section">
    <div class="container">
      <p class="arch-note reveal">
        <strong>How to read the badges.</strong>
        <span class="tag tag-green">live</span> has a public URL you can open.
        <span class="tag tag-blue">released</span> is an installable package or binary
        with no hosted URL. <span class="tag">source</span> is code-complete and tested
        on GitHub but not deployed, usually because it needs a server with a persistent
        disk or a cloud account; each README says exactly what is left. <span
          class="tag tag-yellow">private build</span
        > has no public repo yet; I can walk through it on a call.
      </p>
    </div>
  </section>

  <section class="section" id="earlier">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Foundation — university, 2023 to 2026</p>
        <h2 class="display">Earlier work</h2>
      </div>
      <div class="rows reveal">
        <div class="row">
          <span class="row-key">Linux</span>
          <div>
            <h3>Linux server administration lab</h3>
            <p>
              Ubuntu VMs administered entirely from the shell: users and
              permissions, services, cron jobs, and real-time monitoring via
              Bash scripting.
            </p>
          </div>
          <span class="row-note">Bash</span>
        </div>
        <div class="row">
          <span class="row-key">Cisco PT</span>
          <div>
            <h3>Enterprise network simulation</h3>
            <p>
              Multi-VLAN networks with inter-VLAN routing, DNS, DHCP and WAN
              links, designed and simulated in Cisco Packet Tracer.
            </p>
          </div>
          <span class="row-note">VLAN, DNS/DHCP</span>
        </div>
        <div class="row">
          <span class="row-key">Python</span>
          <div>
            <h3>Motorola 6809 processor simulator</h3>
            <p>
              Reproduced the full 6809 CPU in software: instruction fetch,
              decode and execution cycle implemented from scratch.
            </p>
          </div>
          <span class="row-note">CPU architecture</span>
        </div>
        <div class="row">
          <span class="row-key">PL/SQL</span>
          <div>
            <h3>Advanced database management</h3>
            <p>
              Relational schemas with stored procedures, triggers, cursors and
              query optimisation, Oracle running in Docker for reproducible
              environments.
            </p>
          </div>
          <span class="row-note">Oracle, Docker</span>
        </div>
        <div class="row">
          <span class="row-key">React</span>
          <div>
            <h3>Full-stack web applications</h3>
            <p>
              Dynamic web apps with REST APIs, session management and responsive
              UI: PHP and Node back-ends integrated with React front-ends.
            </p>
          </div>
          <span class="row-note">Node.js, MySQL</span>
        </div>
      </div>
    </div>
  </section>
</Base>
