---
import Base from "../layouts/Base.astro";
import ShipLog from "../components/ShipLog.astro";
import Window from "../components/Window.astro";
import ProjectCard from "../components/ProjectCard.astro";
import aiCreate from "../assets/img/onebotads-ai-create.webp";
import { TIMELINE } from "../data/timeline";
import { SKILLS } from "../data/skills";
import { featured, counts } from "../data/projects";

const n = counts();
---

<Base
  title="Ayach Youssef — Software Engineer, Backend & DevOps"
  description="Software engineer focused on backend & DevOps in Morocco. Built and deployed OneBotAds, an AI-powered ad-automation SaaS, from empty backend to a self-managed Linux VPS in production."
>
  <!-- ============ HERO ============ -->
  <section class="hero container">
    <div class="hero-grid">
      <div>
        <p class="eyebrow">
          Software engineer focused on backend &amp; DevOps — Morocco
        </p>
        <h1 class="display">I learn fast, and&nbsp;I&nbsp;<em>ship</em>.</h1>
        <p class="lede">
          In my final-year internship I took OneBotAds from a click-through
          mockup to a production SaaS: six ad-platform integrations, an AI
          campaign agent, and a 17-table PostgreSQL backend — then deployed and
          operated it myself on a Linux VPS, live on the public internet.
        </p>
        <div class="hero-actions">
          <a href="/projects/onebotads/" class="btn btn-primary"
            >Read the OneBotAds case study</a
          >
          <a href="#contact" class="btn">Get in touch</a>
        </div>
      </div>
      <ShipLog entries={TIMELINE} />
    </div>
  </section>

  <!-- ============ FEATURED WORK ============ -->
  <section class="section" id="work">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Featured — final-year internship, Jobistart</p>
        <h2 class="display">OneBotAds</h2>
      </div>

      <div class="featured">
        <div class="featured-copy reveal">
          <h3>One interface for a media buyer&rsquo;s entire ad operation.</h3>
          <p>
            Connect Meta, TikTok, Google, Snapchat, LinkedIn and Taboola
            accounts, then manage every campaign from one dashboard — or let the
            AI agent build the campaign for you through conversation. I started
            from a frontend mockup with no backend at all and built everything
            underneath: OAuth for six platforms, the database, the API,
            payments, and the attribution pipeline that ties ad spend to real
            Shopify revenue.
          </p>
          <div class="statgrid">
            <div class="stat"><strong>6</strong> <span>ad platforms</span></div>
            <div class="stat">
              <strong>17</strong>
              <span>database tables</span>
            </div>
            <div class="stat"><strong>35</strong> <span>API routes</span></div>
            <div class="stat"><strong>6</strong> <span>MCP servers</span></div>
          </div>
          <div class="featured-tags">
            <span class="tag tag-blue">React</span>
            <span class="tag tag-green">Node.js / Express</span>
            <span class="tag tag-yellow">PostgreSQL</span>
            <span class="tag tag-red">LLM agent</span>
            <span class="tag tag-yellow">Linux &middot; PM2 &middot; nginx</span
            >
            <span class="tag">Stripe</span>
            <span class="tag">OAuth 2.0</span>
          </div>
          <div class="featured-actions">
            <a href="/projects/onebotads/" class="btn btn-primary">Case study</a
            >
            <a
              href="https://onebotads.net"
              class="btn"
              target="_blank"
              rel="noopener">Live site</a
            >
          </div>
        </div>

        <div class="reveal">
          <Window
            title="onebotads.net — Create Ad with AI"
            src={aiCreate}
            alt="OneBotAds dashboard: the AI assistant chat on the left filling in a complete ad campaign form on the right, including budgets for Meta and LinkedIn and a live audience estimate"
            caption="The flagship feature: describe a campaign in chat, the agent fills and launches the real form."
            eager
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ALSO BUILT ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Since then — {n.total} projects, {n.live} live</p>
        <h2 class="display">Also built</h2>
        <p class="lede">
          A multi-tenant SaaS with a real security pass, sixty bilingual
          business sites from one engine, and a privacy-first analytics service
          with its own AWS Terraform module. The full list, grouped and badged
          by status, is on the <a href="/projects/">projects page</a>.
        </p>
      </div>
      <div class="bento">
        {featured().map((p, i) => <ProjectCard project={p} index={i} />)}
      </div>
    </div>
  </section>

  <!-- ============ SKILLS ============ -->
  <section class="section" id="skills">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Toolkit</p>
        <h2 class="display">What I work with</h2>
      </div>
      <div class="skills">
        {
          SKILLS.map((g, i) => (
            <div class="skill-group reveal" style={`--index: ${i}`}>
              <h3>{g.title}</h3>
              <ul>
                {g.items.map((s) => (
                  <li>
                    <span class={`tag tag-${g.tone}`}>{s}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ EDUCATION ============ -->
  <section class="section" id="education">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Academic path</p>
        <h2 class="display">Education</h2>
      </div>
      <div class="rows reveal">
        <div class="row">
          <time>2025 — 2026</time>
          <div>
            <h3>Licence ST — Computer Engineering (LSGI)</h3>
            <p>
              Faculty of Sciences and Technology, Settat. Advanced databases,
              OOP in Java, networks and operating systems, UML and software
              engineering.
            </p>
          </div>
          <span class="row-note"></span>
        </div>
        <div class="row">
          <time>2023 — 2025</time>
          <div>
            <h3>DEUST — Mathematics, Computer Science &amp; Physics (MIP)</h3>
            <p>
              Data structures and algorithms in C, probability and statistics,
              numerical analysis.
            </p>
          </div>
          <span class="row-note"></span>
        </div>
        <div class="row">
          <time>2023</time>
          <div>
            <h3>Baccalaureate — Science track</h3>
            <p>Morocco.</p>
          </div>
          <span class="row-note">mention: good</span>
        </div>
      </div>
      <p class="arch-note reveal" style="margin-top: var(--space-8)">
        Languages: Arabic (native) &middot; French (fluent) &middot; English
        (professional).
      </p>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section class="section contact" id="contact">
    <div class="container">
      <p class="eyebrow reveal">Contact</p>
      <h2 class="reveal">Let&rsquo;s build something together.</h2>
      <p class="lede reveal">
        Open to backend and DevOps roles and interesting projects — remote or
        on-site. The fastest way to reach me is email.
      </p>
      <div class="rows contact-rows reveal">
        <a class="row" href="mailto:youssefayach347@gmail.com">
          <span class="row-key">email</span>
          <h3>youssefayach347@gmail.com</h3>
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a
          class="row"
          href="https://wa.me/212698869977"
          target="_blank"
          rel="noopener"
        >
          <span class="row-key">whatsapp</span>
          <h3>+212 698 869 977</h3>
          <span class="arrow" aria-hidden="true">&nearr;</span>
        </a>
        <a
          class="row"
          href="https://github.com/YoussefAyach01"
          target="_blank"
          rel="noopener"
        >
          <span class="row-key">github</span>
          <h3>YoussefAyach01</h3>
          <span class="arrow" aria-hidden="true">&nearr;</span>
        </a>
        <a
          class="row"
          href="https://www.linkedin.com/in/youssefayach"
          target="_blank"
          rel="noopener"
        >
          <span class="row-key">linkedin</span>
          <h3>youssefayach</h3>
          <span class="arrow" aria-hidden="true">&nearr;</span>
        </a>
        <a class="row" href="/cv/">
          <span class="row-key">cv</span>
          <h3>Live CV — view or print to PDF</h3>
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a
          class="row"
          href="https://ceojoe.vercel.app"
          target="_blank"
          rel="noopener"
        >
          <span class="row-key">studio</span>
          <h3>CeoJoe — my startup, a web studio for small businesses</h3>
          <span class="arrow" aria-hidden="true">&nearr;</span>
        </a>
      </div>
    </div>
  </section>
</Base>
